def cmd_oz_sim(args):
    """fpga_top_linux_tb with the checkout's own ps7_gp0, under Verilator (~1 min)."""
    need_tools(["verilator"])
    oz = Path(args.oz).resolve()
    shared = [oz / "rtl" / "ps7_gp0.v", oz / "rtl" / "axi3_to_axilite.v"]
    for f in shared:
        if not f.exists():
            die(f"{f} missing: is {oz} an OpenZynq checkout?")
    rom = REPO / "build" / "boot" / "linux-board" / "rom.hex"
    if not rom.exists():
        die("build/boot/linux-board/rom.hex missing -- run `make boot-board`")
    rvboot = load_rvboot()
    chunks = rvboot.test_chunks()
    stream = OUT / "board_stream.bin"
    OUT.mkdir(parents=True, exist_ok=True)
    stream.write_bytes(b"".join(struct.pack("<I", len(c)) + c
                                for c in (chunks[0], chunks[-1])))
    files = ([str(REPO / "rtl" / f"{m}.v") for m in rvboot.RTL] +
             [str(REPO / "rtl" / "fpga_top_linux.v")] + [str(f) for f in shared] +
             [str(REPO / "tb" / f) for f in ("ps7_hp0_model.v", "axi4_mem.v", "fpga_top_linux_tb.v")])
    obj = OUT / "vobj_top"
    say(f"building fpga_top_linux_tb with {oz.name}'s ps7_gp0 (verilator)")
    sh(["verilator", "--binary", "--timing", "-O3", "-Wno-fatal", "-Wno-lint", "-Wno-style",
        "--top-module", "fpga_top_linux_tb", "-Mdir", str(obj), "-o", "tb"] + files, OUT / "oz-sim.log")
    r = subprocess.run([str(obj / "tb"), f"+ROM={rom}", f"+STREAM={stream}"],
                       cwd=REPO, capture_output=True, text=True)
    for l in r.stdout.splitlines():
        if l.startswith(("board:", "ps7 model:", "PASS", "FAIL")):
            say(l)
    ok = "\nPASS:" in r.stdout
    print("LINUX-BOARD-TOP: " + ("ALL PASS" if ok else "FAIL"))
    sys.exit(0 if ok else 1)


README_OZ = """# {P} — Linux on the RISC-V from riscv-from-scratch, with PS DDR

Generated by riscv-from-scratch (`make linux-oz OZ=...`, Step 54); regenerate
it rather than editing it. The RISC-V is `soc_boot`: a 5-stage RV32IMA core
with M/S/U and Sv32, 2 + 2 KiB caches, a 16 KiB boot ROM with a resident
SBI, a 16550 UART, a CLINT and a PLIC. Its RAM is 64 MiB of the board's
DDR3 (PS `0x1000_0000`..`0x13ff_ffff`), reached through `S_AXI_HP0`.

| | |
|---|---|
| core clock | the PS's FCLK1, 50 MHz (IO PLL / 20, set by the PS program); HP0 runs on it too |
| console | 115200 8N1 on JM1: pin 21 = TX (J18), pin 22 = RX (K19), GND on 3/4 |
| K1 | resets the RISC-V (its ROM prompts `boot> ` again) |
| LED1 | the RISC-V has powered off |
| LED2 | heartbeat once the PS has released the RISC-V |
| GP0 `0x4000_0000` | reads `RVFS`; write 1 = run, 0 = hold in reset |
| GP0 `0x4000_0004` | bit 0 run, bit 1 powered off |

## Run it

```bash
make -C projects/{P}/ps vivado-init     # the board's Vivado ps7_init (DDR training)
make sim  PROJECT={P}                   # optional; slow under Icarus (about 1.5 hours)
make bit  PROJECT={P}
make run  PROJECT={P}                   # the PL, then the PS program: it initialises
                                        # and checks DDR, then releases the RISC-V
```

The PS program reports on UART0 (the on-board USB-C, CH340). Then, from
riscv-from-scratch, with a 3.3 V USB-serial adapter on JM1:

```bash
tools/rvboot send /dev/ttyUSB0 build/linux/linux-board.rvbi
```

It waits for `boot> `, sends the kernel (2.6 MB, about 4 minutes at 115200)
and becomes a terminal: Linux boots to `rvfs# `.

## Boot from flash, with no PC

`boot.bif` puts the PS program (as the FSBL), the bitstream and
`fw/boot.rvbi` (U-Boot + Linux, copied in by the export) in one BOOT.BIN.
In QSPI boot mode the BootROM starts the PS program; it programs the PL
through PCAP, copies the image to DDR `0x1300_0000` and releases the
RISC-V, whose ROM boots it after a second (a key on JM1 first gets
`boot> `). In JTAG mode the same program reports what the flash holds.

```bash
make -C projects/{P}/ps                 # the FSBL (needs ps7_init, as above)
make bit PROJECT={P}
mkbootimage projects/{P}/boot.bif BOOT.BIN
make run PROJECT={P}                    # JTAG mode: the PS program listens on UART0
```

then, from riscv-from-scratch, on the CH340's port (not JM1's):

```bash
tools/rvboot flash /dev/ttyUSB1 BOOT.BIN   # about 7 minutes at 115200
```

It writes the flash only after the whole file arrived with the right CRC
and parses as this project's BOOT.BIN, and reads it back. Then set the boot
mode to QSPI and power-cycle. `make -C projects/{P}/ps test` checks the
parser and the flash writer on a PC, against a model.

## Status

`make bit` builds it (about 5 minutes): 35 % of nextpnr's LUT sites, 12 %
of its flip-flops, routed, with the core clock at 51.47 MHz after routing
against the 50 MHz it runs at, with `project.mk`'s seed (riscv-from-scratch
Steps 57 and 58, `docs/57-fitting-the-board.md`,
`docs/58-faster-board-core.md`). To get there the board build divides in 33
cycles, multiplies in 3, has its own load/store address adder, a registered
D-TLB lookup, a registered branch redirect, forwarding compares made a
cycle early, a registered fetch-page translation, no Zba/Zbb/Zbc/Zbs and no
branch predictor, and runs on FCLK1. The margin is 2.9 %, of an estimate.
`prebuilt/` holds a bitstream built this way and the U-Boot + Linux image.

Simulated only otherwise: `make sim` here, and riscv-from-scratch's
`tools/rvlinux run --board`, which boots U-Boot and Linux on this
configuration (and `--frommem`, from the image where the FSBL leaves it).
The FSBL's PCAP and QSPI code has only run against a model. It has not run
on a board; OpenZynq's DDR and HP0 path is not yet validated on hardware
either.
"""


# ---- run --------------------------------------------------------------
def image_parts():
    img = (OUT / "Image").read_bytes()
    if img[0x38:0x3c] != b"RSC\x05":
        die("build/linux/Image is not a RISC-V Linux Image")
    return img, struct.unpack_from("<Q", img, 16)[0]


def cmd_run(args):
    need_tools(["verilator"])
    board = args.board
    if board:                      # 2.6 MB at 115200 would be 11G cycles: preload
        args.fast = True
    if args.frommem:               # the whole image in memory: nothing to send but commands
        args.fast = False
    rom = REPO / "build" / "boot" / ("linux-board/rom.hex" if board else "rom.hex")
    if not rom.exists():
        die(f"{rom.relative_to(REPO)} missing -- run `make {'boot-board' if board else 'boot-sw'}`")
    if not (OUT / "Image").exists():
        die("build/linux/Image missing -- run `tools/rvlinux build`")
    bootargs = BOARD_BOOTARGS if board else BOOTARGS
    rvboot = load_rvboot()
    img, size = image_parts()
    # what the image holds: the kernel at 0x80400000 -- or, with --uboot,
    # U-Boot there and the kernel at KERNEL_LOAD for its booti to move down
    entry, segs = KERNEL_BASE, [(KERNEL_BASE, img, size)]
    if args.uboot:
        flavor = "board" if board else "sim"
        if not uboot_elf(flavor).exists():
            die(f"{uboot_elf(flavor).relative_to(REPO)} missing -- run `tools/rvlinux uboot`")
        entry, segs = rvboot.elf_segments(uboot_elf(flavor))
        segs = segs + [(KERNEL_LOAD, img, len(img))]
        bootargs = UBOOT_FLAVORS[flavor]["bootargs"]
    if args.frommem:
        # Step 56: where the PS program leaves it, copied from flash
        boot = rvboot.make_image(entry, segs, bootargs.encode())
        rvboot.write_preload(OUT / "preload.hex", [(rvboot.BOOTMEM_ADDR, boot)])
    elif args.fast:
        a0, d0, _ = segs[0]
        head = d0[:4096]           # over 256 bytes: sent at line rate, not typed
        boot = rvboot.make_image(entry, [(a0, head, len(head))], bootargs.encode())
        pre = OUT / "preload.hex"
        with open(pre, "w") as f:
            for a, d, _ in segs:
                words = d + b"\0" * (-len(d) % 4)
                f.write(f"@{(a - RAM_BASE) // 4:08x}\n")
                for i in range(0, len(words), 4):
                    f.write(f"{struct.unpack_from('<I', words, i)[0]:08x}\n")
    else:
        boot = rvboot.make_image(entry, segs, bootargs.encode())
    (OUT / "linux.rvbi").write_bytes(boot)
    chunks = ([] if args.frommem else [boot]) + [(c + "\r").encode() for c, _ in COMMANDS]
    stream = OUT / "stream.bin"
    stream.write_bytes(b"".join(struct.pack("<I", len(c)) + c for c in chunks))

    variant = "board-ddr" if board else "ddr"
    say(f"building the bench ({rvboot.MEMSYS[variant]['desc']}) with verilator")
    exe = rvboot.build_sim("verilator", variant)
    log, out = OUT / "linux.log", OUT / "sim.out"
    cmd = exe + [f"+ROM={rom}", f"+STREAM={stream}", f"+LOG={log}", f"+MAXCYC={args.max_cycles}",
                 f"+PROMPT={PROMPT}", f"+TYPEGAP={BOARD_TYPEGAP if board else TYPEGAP}"]
    if args.fast or args.frommem:
        cmd.append(f"+PRELOAD={OUT / 'preload.hex'}")
    what = "U-Boot + the kernel" if args.uboot else "the kernel"
    how = (f"--frommem: {what} as one image at 0x{rvboot.BOOTMEM_ADDR:08x}, nothing sent" if args.frommem else
           f"--fast: {what} preloaded, the ROM sent its first 4 KiB" if args.fast else
           f"{what} over the serial line ({len(boot)} bytes, ~{len(boot) * 160 // 10**6}M cycles)")
    say(f"booting: {how}; console in {log.relative_to(REPO)}")
    t0 = time.time()
    with open(out, "w") as f:
        p = subprocess.Popen(cmd, cwd=REPO, stdout=f, stderr=subprocess.STDOUT)
        last = None
        while p.poll() is None:
            time.sleep(15)
            lines = log.read_text(errors="replace").replace("\r", "").split("\n") if log.exists() else []
            now = next((l for l in reversed(lines) if l.strip()), None)
            if now and now != last:
                say(f"  {int(time.time() - t0):5d}s  {now[:100]}")
                last = now
    say(f"simulation done in {int(time.time() - t0)}s")
    extra = (UBOOT_LINES if args.uboot else []) + (BOOTMEM_LINES if args.frommem else [])
    sys.exit(check(out.read_text(errors="replace"), log.read_text(errors="replace"), len(chunks),
                   extra, rom_prompt=not args.frommem))


def check(sim, console, nchunks, extra=(), rom_prompt=True):
    fails = []
    m = re.search(r"BOOT-TB: (\w+) exit=(\d+) cycles=(\d+) resets=(\d+) chunks=(\d+)", sim)
    if not m:
        print(sim[-3000:])
        die("no summary from the bench")
    state, code, cycles, _, chunks = m.group(1), *map(int, m.groups()[1:])
    text = console.replace("\r", "")
    lines = text.split("\n")
    for pat in list(extra) + BOOT_LINES:
        if not any(re.search(pat, l) for l in lines):
            fails.append(f"boot: no line matching {pat!r}")
    # each command's output: from its echo to the next prompt
    pos = 0
    for cmd, pats in COMMANDS:
        at = text.find(PROMPT + cmd, pos)
        if at < 0:
            fails.append(f"`{cmd}` was never echoed at a prompt")
            continue
        end = text.find(PROMPT, at + len(PROMPT))
        seg = text[at:end if end >= 0 else len(text)].split("\n")[1:]
        for pat in pats:
            if not any(re.search(pat, l) for l in seg):
                fails.append(f"`{cmd}`: no output line matching {pat!r}")
        pos = at + 1
    bad = [l for l in lines if re.search(NEVER, l)]
    if bad:
        fails.append(f"the kernel complained: {bad[0]!r}")
    if state != "halted" or code != 0:
        fails.append(f"the machine did not power off cleanly ({state}, exit code {code})")
    if chunks != nchunks:
        fails.append(f"sent {chunks} of {nchunks} chunks")

    load = re.search(r"data: (\d+) bytes, CRC32 0x[0-9a-f]+ ok \((\d+) cycles", text)
    rom = re.search(r"BOOT-TB prompt 1 at cycle (\d+)", sim) if rom_prompt else None
    shell = re.search(rf"BOOT-TB prompt {2 if rom_prompt else 1} at cycle (\d+)", sim)
    say(f"{state}, exit code {code}, {cycles:,} cycles in all")
    if load:
        say(f"  {int(load.group(2)):>11,} cycles: the ROM {'receiving' if rom_prompt else 'checking and copying'}"
            f" the image ({int(load.group(1)):,} bytes)")
    if shell and not rom_prompt:
        say(f"  the shell prompt at cycle {int(shell.group(1)):,} (from reset, nothing sent)")
    if shell and load and rom:
        entry = int(rom.group(1)) + int(load.group(2))      # "boot> ", then the image
        say(f"  {int(shell.group(1)) - entry:>11,} cycles: kernel entry to the shell prompt "
            f"(cycle {int(shell.group(1)):,})")
    say(f"  {len(COMMANDS)} commands typed; "
        f"{sum(len(p) for _, p in COMMANDS) + len(BOOT_LINES) + len(extra)} output checks")
    for f in fails:
        say(f"FAIL: {f}")
    print("LINUX: FAIL" if fails else "LINUX: ALL PASS")
    return 1 if fails else 0


def main():
    ap = argparse.ArgumentParser(description="Linux on the boot platform, from source")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("fetch", help="clone the pinned sources into third_party/")
    sub.add_parser("build", help="musl, busybox, initramfs, kernel -> build/linux/")
    for name in ("run", "all"):
        p = sub.add_parser(name, help="boot it and check" if name == "run" else "fetch + build + run")
        p.add_argument("--fast", action="store_true",
                       help="preload the kernel into the DDR model instead of sending it")
        p.add_argument("--board", action="store_true",
                       help="the board's configuration: board ROM, 115200, 64-bit HP0 port (implies --fast)")
        p.add_argument("--uboot", action="store_true",
                       help="boot U-Boot, which boots the kernel (needs `rvlinux uboot`)")
        p.add_argument("--frommem", action="store_true",
                       help="the whole image already in memory at 0x83000000, as the PS leaves it "
                            "from flash: the ROM boots it with nothing sent (Step 56)")
        p.add_argument("--max-cycles", type=int, default=MAX_CYCLES)
    sub.add_parser("board-image", help="build/linux/linux-board.rvbi, bootargs at 115200")
    sub.add_parser("uboot", help="fetch + build U-Boot (sim and board builds) and its images")
    p = sub.add_parser("oz-export", help="write projects/riscv_linux into an OpenZynq checkout")
    p.add_argument("oz", help="the OpenZynq checkout")
    p.add_argument("--force", action="store_true", help="replace a project rvlinux did not write")
    p = sub.add_parser("oz-sim", help="the board top with an OpenZynq checkout's ps7_gp0, under verilator")
    p.add_argument("oz", help="the OpenZynq checkout")
    args = ap.parse_args()
    if args.cmd == "fetch":
        cmd_fetch()
    elif args.cmd == "build":
        cmd_build()
    elif args.cmd == "run":
        cmd_run(args)
    elif args.cmd == "board-image":
        cmd_board_image()
    elif args.cmd == "uboot":
        cmd_uboot()
    elif args.cmd == "oz-export":
        cmd_oz_export(args)
    elif args.cmd == "oz-sim":
        cmd_oz_sim(args)
    else:
        cmd_fetch()
        cmd_build()
        cmd_run(args)


if __name__ == "__main__":
    main()
