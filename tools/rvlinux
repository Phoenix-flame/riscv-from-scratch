# `make linux-oz OZ=<this checkout>` there instead of editing.
# soc_boot (MEMSYS 2) on the PS's FCLK1 (50 MHz); its RAM is PS DDR 0x1000_0000
# + 64 MiB over S_AXI_HP0; the PS program initialises DDR and says "run".
TOP      := fpga_top_linux
SIM_TOP  := fpga_top_linux
XDC      := {p}/{OZ_PROJECT}.xdc

RV_RTL   := {rtl_lines}
RV_SRCS  := $(addprefix {p}/,$(RV_RTL)) {p}/fpga_top_linux.v rtl/ps7_gp0.v rtl/axi3_to_axilite.v
SRCS     := $(RV_SRCS)
# make sim: the same top with a PS7 model (FCLK0; HP0 -> a DDR model; the PS
