# The ROM and the firmware RAM are block RAM: let Yosys infer them.
SYNTH_OPTS := -flatten -abc9 -arch xc7
# the core's clock: the PS's FCLK1, which the PS program sets to 50 MHz
# (FCLK0, 100 MHz, only clocks GP0's registers); nextpnr times every clock
# against this, so read its per-clock report, not the PASS/FAIL line. The
# core's routed speed moves with the placement seed (Step 58: 43-51 MHz);
# this one was picked from a sweep, and a changed netlist needs a new one
NEXTPNR_OPTS := --freq 50 --seed {OZ_SEED}
""")
    (dst / "boot.bif").write_text(BOOT_BIF.replace("{P}", OZ_PROJECT))
