# =====================================================================
# uboot.config  -  U-Boot v2024.10 for soc_boot (Step 55)
# ---------------------------------------------------------------------
# Applied on top of qemu-riscv32_smode_defconfig by tools/rvlinux, which
# checks that every line holds afterwards. CONFIG_BAUDRATE, BOOTDELAY and
# BOOTARGS are set per build (sim: 3.125 Mbaud, no delay; board: 115200,
# 2 s to interrupt): U-Boot reprograms the UART divisor from its own baud
# rate and the DT's clock-frequency, ignoring current-speed.
# =====================================================================

# the core: RV32IMA, no C / F / D (and no EFI, which would want them)
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_F is not set
# CONFIG_RISCV_ISA_D is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTEFI_SELFTEST is not set
# the boot ROM already prints; no early debug UART at a guessed address
# CONFIG_DEBUG_UART is not set

# boot Linux from where the combined image puts it (tools/rvlinux:
# KERNEL_LOAD); booti moves it to RAM + text_offset = 0x8040_0000
CONFIG_CMD_BOOTI=y
# ... and keep U-Boot off it: the qemu default puts the pre-console
# buffer (messages before the console is up) at 0x8100_0000 -- it wrote
# "U-Boot 2024.10" over the kernel's first 4 KiB, and booti found no magic
# CONFIG_PRE_CONSOLE_BUFFER is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="booti 0x81000000 - ${fdtcontroladdr}"
CONFIG_USE_BOOTARGS=y

# and the commands worth having at the prompt
CONFIG_CMD_POWEROFF=y
CONFIG_CMD_LOADB=y
CONFIG_CMD_FDT=y
CONFIG_CMD_MEMORY=y
