# =====================================================================
# kernel.config  -  Linux 6.18 for soc_boot (Step 53)
# ---------------------------------------------------------------------
# A fragment applied on top of `make tinyconfig`; tools/rvlinux applies
# it and then checks that every line below holds in the final .config.
# A "# ... is not set" line also holds if the option is absent.
# CONFIG_INITRAMFS_SOURCE is set by tools/rvlinux (it is a build path).
# =====================================================================

# ---- the CPU: rv32ima_zicsr_zifencei, Sv32, one hart -----------------
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_ARCH_RV64I is not set
CONFIG_MMU=y
# CONFIG_SMP is not set
# no C extension: compressed instructions would be illegal (and EFI,
# which forces them on, goes too)
# CONFIG_RISCV_ISA_C is not set
# CONFIG_EFI is not set
# CONFIG_FPU is not set
# Zb* exist in this core, but the kernel need not depend on them
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# misaligned accesses trap (Step 52): emulate them, no timing probe
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
# CONFIG_RISCV_SLOW_UNALIGNED_ACCESS is not set
# CONFIG_RISCV_PROBE_UNALIGNED_ACCESS is not set

# ---- the platform: SBI, timer, PLIC, ns16550a ------------------------
CONFIG_RISCV_SBI=y
CONFIG_RISCV_TIMER=y
CONFIG_SIFIVE_PLIC=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_UNIX98_PTYS=y
# 256 BSD pty pairs cost 5.9 s of boot on this core (pty_init)
# CONFIG_LEGACY_PTYS is not set
CONFIG_POWER_RESET=y

# ---- a userland: busybox in an uncompressed initramfs ----------------
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
