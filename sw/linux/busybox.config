# =====================================================================
# busybox.config  -  busybox 1.36.1 for the initramfs (Step 53)
# ---------------------------------------------------------------------
# Applied on top of `make allnoconfig` by tools/rvlinux, which checks
# that each line holds afterwards. Static, against musl (rv32 ilp32).
# =====================================================================
CONFIG_STATIC=y
# musl's off_t is always 64 bits
CONFIG_LFS=y

# ---- the shell -------------------------------------------------------
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_ALIAS=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_CTTYHACK=y
CONFIG_SETSID=y

# ---- a few tools -----------------------------------------------------
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_WC=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_SEQ=y
CONFIG_EXPR=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_SLEEP=y
CONFIG_DATE=y
CONFIG_ENV=y
CONFIG_PWD=y
CONFIG_BASENAME=y
CONFIG_HOSTNAME=y
CONFIG_UNAME=y
CONFIG_LN=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_TOUCH=y
CONFIG_MKDIR=y
CONFIG_CLEAR=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_PS=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_DMESG=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
